# Copy to .env and fill in real values. Used by FastAPI (load_dotenv in db + memory modules).

OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=agent-graveyard
PINECONE_ENVIRONMENT=us-east-1
# For local SQLite:
# DATABASE_URL=sqlite:///./graveyard.db
# For Neon Postgres:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional alias supported by backend:
# NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=your_secret_key
BACKEND_URL=http://localhost:8000
