# ════════════════════════════════════════════════
#  Agent Graveyard — Environment Configuration
#  Copy this file to .env and fill in your values
#  cp backend/.env.example backend/.env
# ════════════════════════════════════════════════

# ── PINECONE (Vector Database) ───────────────────
# Free account at: https://pinecone.io
# Dashboard → API Keys → Create API Key
PINECONE_API_KEY=your_pinecone_api_key_here

# Name for your Pinecone index (leave as-is)
PINECONE_INDEX_NAME=agent-graveyard

# Region (check your Pinecone dashboard)
PINECONE_ENVIRONMENT=us-east-1

# ── OPENROUTER (LLM — Free Models Available) ────
# Free account at: https://openrouter.ai
# Dashboard → API Keys → Create Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free model (costs $0.00):
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Paid alternatives (better quality):
# OPENROUTER_MODEL=anthropic/claude-3-haiku
# OPENROUTER_MODEL=openai/gpt-4o-mini

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── DATABASE ─────────────────────────────────────
# Option 1: Neon (free cloud Postgres)
#   Sign up: https://neon.tech
#   New Project → Connection Details → Connection string
#   Copy the "psycopg" format connection string
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Optional alias (backend accepts either):
# NEON_DATABASE_URL=postgresql+psycopg://...

# Option 2: Local SQLite (simplest, no account needed)
# DATABASE_URL=sqlite:///./graveyard.db

# ── EMBEDDINGS (local — no API key needed) ───────
# These run on your machine via sentence-transformers
# First run will download ~400MB model (one time only)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Optional: suppress stderr banner on first embedding model download (default: show banner)
# AGENT_GRAVEYARD_QUIET_EMBED=true

# Wisdom retrieval: minimum cosine similarity for "has_warnings" (default 0.70)
# WISDOM_SIMILARITY_THRESHOLD=0.65

# ── APP SETTINGS ─────────────────────────────────
# Change this to any random string for security
SECRET_KEY=change-this-to-any-random-string-you-like

# Backend host and port (optional; run.sh / run.ps1 pass --host/--port to uvicorn directly)
# 0.0.0.0 = listen on all interfaces (Docker). For a browser on the same PC, use http://localhost:PORT — never http://0.0.0.0:PORT
HOST=0.0.0.0
PORT=8000

# Optional: used by some clients / docs
BACKEND_URL=http://localhost:8000
